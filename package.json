{
  "name": "wyatts-scooter-adventure",
  "version": "1.0.0",
  "description": "A web-based 2D scooter game for kids featuring Wyatt's journey to the park",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "test:run": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakeklineIsReal/ae-bootcamp-capstone.git"
  },
  "keywords": [
    "phaser",
    "game",
    "kids",
    "scooter",
    "educational"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/jakeklineIsReal/ae-bootcamp-capstone/issues"
  },
  "homepage": "https://github.com/jakeklineIsReal/ae-bootcamp-capstone#readme",
  "dependencies": {
    "phaser": "^3.70.0"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "gh-pages": "^6.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
